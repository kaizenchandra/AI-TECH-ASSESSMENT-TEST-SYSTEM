# Generate a local password; do not commit .env
DATABASE_PASSWORD=replace-with-a-random-local-password
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
AI_MODE=fake
APP_ENV=local
# Application quota units, not currency. Monetary accounting remains a production gate.
AI_BUDGET_UNITS=10000
# Set only for approved live-provider use. Never commit a real key.
AI_MODEL=
AI_API_KEY=
AI_LIVE_APPROVED=false
# Separate execution gateway. Never use a host shell or mount a Docker socket into backend.
# HTTPS endpoint must terminate at your isolated gateway; blank keeps jobs visibly unavailable.
RUNNER_URL=
RUNNER_TOKEN=
# Separate explicit gate for external post-submission candidate code processing.
# Requires organization policy/contract/region/retention approval; fake mode stays local.
AI_CANDIDATE_PROCESSING_APPROVED=false
